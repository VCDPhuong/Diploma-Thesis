use_ws_distance = .false.
!restart = plot
num_bands = 34          ! In nscf calculation's file, only 34 bands are shown
num_wann = 22  !2Ru: 3 from 4d, 1 from 5s, 2O: 2 from 2p (only 1 spin is considered) 

num_iter = 2000
wannier_plot_supercell = 3
spin = down

! fermi_surface_plot = true
! Band structure plotting
! bands_plot = true
! bands_num_points = 100
fermi_energy = 12.2534 !scan


! dos = true
! dos_task = dos_plot
! dos_project = 1,6
! dos_kmesh = 16 16 25


dis_win_min = 3.0
dis_win_max = 20.0
!dis_froz_max = 12.2536 !everything will be froze below this, I don't think this is good for metalic system


iprint = 5


begin unit_cell_cart
ang
  4.5405   0.0000   0.0000
  0.0000   4.5405   0.0000
  0.0000   0.0000   3.1323
end unit_cell_cart



begin atoms_frac
Ru1    0.000   0.000   0.000
Ru2    0.500   0.500   0.500
O1     0.195   0.805   0.500
O2     0.805   0.194   0.500
O3     0.695   0.695   0.000
O4     0.305   0.305   0.000
end atoms_frac


begin projections
Ru1: d
Ru2: d
O1: p
O2: p
O3: p
O4: p
end projections


berry_curv_unit = bohr2
!berry = true
!berry_task = ahc
!berry_kmesh = 25 25 25
!fermi_energy_min = 11.5 !scan
!fermi_energy_max = 12.5

kslice = true
kslice_task = curv+fermi_lines     ! Calculate Berry curvature and Fermi lines on slice
kslice_corner = 0.0 0.0 0.0        ! Gamma point (corner 1)
kslice_b1 = 0.0 0.5 0.0            ! Direction to M point
kslice_b2 = 0.0 0.0 0.5            ! Direction to A point (via Z)
kslice_2dkmesh = 96 96           ! 2D k-mesh for the slice, matching nscf mp_grid


begin kpoint_path
G 0.0 0.0 0.0    X 0.5 0.0 0.0
X 0.5 0.0 0.0    R 0.5 0.0 0.5
R 0.5 0.0 0.5    Z 0.0 0.0 0.5
Z 0.0 0.0 0.5    G 0.0 0.0 0.0
G 0.0 0.0 0.0    M 0.5 0.5 0.0
M 0.5 0.5 0.0    A 0.5 0.5 0.5
A 0.5 0.5 0.5    Z 0.0 0.0 0.5
end kpoint_path



mp_grid = 16 16 25
begin kpoints
