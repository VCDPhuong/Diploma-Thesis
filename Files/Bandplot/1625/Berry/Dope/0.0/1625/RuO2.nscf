    verbosity = 'high',                 
    tprnfor = .true.,                  
    tstress = .true.,                 
/       
&SYSTEM                                
    ibrav = 6,                          
    a = 4.5405,                  
    c = 3.1323,
    nat = 6,                            
    ntyp = 3,
    nspin = 2,                         
    starting_magnetization(1) = 0.8,    
    starting_magnetization(2) = -0.8,   
    starting_magnetization(3) = 0.0,   
    ecutwfc=90,
    ecutrho=700,
    occupations = 'smearing',          
    smearing = 'mv',                    
    degauss=0.005d0,
    nosym =.true.,    
    noinv =.true.,
    nbnd = 34,
    !occupations = 'tetrahedra'
/

&ELECTRONS                              
